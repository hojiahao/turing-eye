    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
